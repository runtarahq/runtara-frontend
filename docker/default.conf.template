# The console's site, rendered by the nginx image's envsubst step at start
# (RUNTARA_UI_LISTEN: a port, default 8080, or an address and port such as
# 127.0.0.1:17989 on the host network). docker/render-config.sh writes
# config.js and security-headers.conf into /tmp/runtara at every start.
# add_header in a location replaces the server's, so each location includes
# the headers.
server {
    listen ${RUNTARA_UI_LISTEN};
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    location = /config.js {
        alias /tmp/runtara/config.js;
        default_type text/javascript;
        include /tmp/runtara/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location /assets/ {
        include /tmp/runtara/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # For the container's own health check.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Every other path is a console page: index.html, with its pages' routes
    # resolved in the browser.
    location / {
        include /tmp/runtara/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
